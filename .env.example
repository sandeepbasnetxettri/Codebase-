PORT=4000
NODE_ENV=development
JWT_SECRET=replace-this-with-at-least-32-random-characters
DATABASE_URL=postgresql://wallet:wallet_dev_password@localhost:5432/wallet_dev?schema=public
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:19000
EXPO_PUBLIC_API_URL=http://localhost:4000

# eSewa ePay v2 (use EPAYTEST and sandbox secret for UAT; production values come from eSewa)
ESEWA_ENV=sandbox
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=replace-with-eSewa-issued-secret
API_PUBLIC_URL=http://localhost:4000
