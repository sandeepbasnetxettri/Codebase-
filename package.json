{
  "name": "nepal-wallet-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Independent Nepal-focused digital wallet demo monorepo",
  "workspaces": ["apps/api", "apps/mobile"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:api": "npm run dev -w @wallet/api",
    "dev:mobile": "npm run start -w @wallet/mobile",
    "dev:web": "npm run web -w @wallet/mobile",
    "build:api": "npm run build -w @wallet/api",
    "db:generate": "npm run prisma:generate -w @wallet/api",
    "db:migrate": "npm run prisma:migrate -w @wallet/api"
  }
}